{
  "name": "realtime-chat-app",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "server": "node server.js",
    "client": "cd client && npm run dev -- --host 0.0.0.0",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npm run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
